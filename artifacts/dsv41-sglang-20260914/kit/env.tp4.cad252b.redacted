# 4x DGX Spark profile (TP4/EP4) — OUR fabric (adapted 2026-09-14)
# Cluster: forge head 192.168.10.1, anvil .2, ember .3, flame .4 (RoCE rail)

# ─── cluster ──────────────────────────────────────────────────────────────────
HEAD_IP=192.168.10.1
WORKER_IPS="192.168.10.2 192.168.10.3 192.168.10.4"
WORKER_HOSTS="anvil ember flame"
WORKER_USER=jun
SSH_IDENTITY=$HOME/.ssh/id_ed25519_shared

# ─── fabric (ConnectX-7 RoCE rail 192.168.10.0/24) ────────────────────────────
FABRIC_IFACE=enP2p1s0f1np1
GLOO_SOCKET_IFNAME=enP2p1s0f1np1
NCCL_SOCKET_IFNAME=enP2p1s0f1np1
IB_HCA=roceP2p1s0f1
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
NCCL_DEBUG=WARN
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
NCCL_DEBUG_SUBSYS=INIT,ENV
NCCL_HOST_DIR=$HOME/nccl-2.30.7

# ─── model / image ────────────────────────────────────────────────────────────
MODEL_DIR=/home/jun/models/deepseek-v4.1-flash-uncensored-fp8
COMMON_MODEL=/home/jun/models/deepseek-v4.1-flash-uncensored-fp8
# Pinned digest (2026-09-25 cad252b recipe): the dev-dsv41 tag moves, the digest does not.
BASE_IMAGE=lmsysorg/sglang:dev-dsv41@sha256:3dbc313030a6ef2c5d7de8ecf48e9aece722694a82182cb618cc82b588816349
IMAGE=dsv41-4x-spark:local
PORT=8000

# ─── weights on anvil/ember/flame (NFSv4 from forge) ──────────────────────────
NFS_SHARE=0
NFS_VOLUME=dsv41-weights-unc
NFS_EXPORT_NAME=dsv41-native
NFS_SERVER_IPS="192.168.10.1"
NFS_CLIENTS=192.168.10.2,192.168.10.3,192.168.10.4

# ─── parallelism (4 Sparks) ──────────────────────────────────────────────────
NNODES=4
TP_SIZE=4
EP_SIZE=4
DIST_PORT=20000
SERVED_MODEL_NAME=deepseek-v4.1-flash

# ─── serving (kit TP4 defaults) ───────────────────────────────────────────────
OFFLOAD_MODE=nvme
DSV41_CACHE_GIB=4
DSV41_IO_THREADS=96
DSV41_RESIDENT_SCALES=0
DSV41_CACHE_WAYS=16
DSV41_STATS_SECONDS=60
CONTEXT_LENGTH=1048576
MEM_FRACTION_STATIC=0.80
HEAD_MEM_FRACTION_STATIC=0.80
MAX_RUNNING_REQUESTS=8
# 4096 is safe at any context WITH DSV41_INDEXER_CHUNKED=1 (bounded logits transient)
CHUNKED_PREFILL_SIZE=4096
MAX_TOTAL_TOKENS=8000000
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=3
DSPARK_SPS_TABLE=/state/dspark_sps.json
DSPARK_STS_TABLE=/state/dspark_sts.json

# ─── engram local shards ──────────────────────────────────────────────────────
ENGRAM_DIR=$HOME/dsv41-engram-unc
DSV41_PACKED_DIR=/engram
SKIP_PREPARE=1
SKIP_VERIFY=1
SKIP_SMOKE=0
SMOKE_QUICK=1

# ─── kernels (GB10 / SM121) ───────────────────────────────────────────────────
EXTRA_SGLANG_ARGS="--enable-session-radix-cache --fp8-gemm-backend flashinfer_cutlass --watchdog-timeout 1800 --min-free-slots-delay 1 --enable-deepseek-v4-fp4-indexer --enable-cache-report --sleep-on-idle"
DSV41_MXFP8_BACKEND=b12x
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192

# ─── TP4 runtime ──────────────────────────────────────────────────────────────
DSV41_TP_PAD=0
WORKER_DIR=/home/jun/dsv41-4x-spark

# ── upstream 93d9e6b serving hardening (2026-09-15) ──────────────────────────
SGLANG_DSV41_REASONING_EFFORT=75
DSV41_MAX_NEW_TOKENS=32768
DSV41_LOOP_ABORT=1
DSV41_LOOP_NGRAM=32
DSV41_LOOP_REPEATS=4
DSV41_LOOP_LINE_REPEATS=8
WORKER_ENGRAM_DIR=/home/jun/dsv41-4x-spark/engram-unc
SGLANG_DSPARK_ENABLE_SPS_RECORD=0
SGLANG_TOOL_STRICT_LEVEL=1

# ─── 2026-09-25 cad252b production adapters (switched line, base image) ──────
# shared_pad_k: TP4 shared-expert down_proj back onto b12x (bit-identical, -0.9ms/step)
DSV41_SHARED_PAD_K=1
# Adapter suite from the Mia TP4 production line. Skipped (canary-roce only, phase 2):
# RoCEnante allreduce/gather, SPARK_PREFILL_TP_SPLIT, EP_SIZE=1 + DSV41_MOE_B12X_NEXT, DSV41_DRAFT_TAU.
# Exactness guarantees: WO_A_W8 converts only layers whose fp8 twin is bit-exact (boot-checked);
# BLOCK_VERIFY/VERIFY_CAP preserve the output distribution; ENGRAM_PREFETCH bitwise-identical rows.
EXTRA_CONTAINER_ENV="DSV41_INDEXER_CHUNKED=1 DSV41_FAST_LOAD=1 DSV41_FAST_LOAD_EP_SIZE=4 DSV41_FAST_LOAD_N_EXPERTS=384 DSV41_FAST_LOAD_INFLIGHT_GB=6 DSV41_ENGRAM_PREFETCH=1 DSV41_WO_A_W8=1 DSV41_WO_A_W8_MID=1 DSV41_WO_A_W8_DROP=1 DSV41_DRAFT_HEAD_FP8=1 DSV41_DRAFT_HEAD_FP8_IMPL=tp4 DSV41_BLOCK_VERIFY=1 DSV41_FOLDED_FENCE=1 DSV41_AUTOTUNE_KEEP=1 DSV41_REPLICATED_SPLIT=wqkv_a,engram.wkv DSV41_DRAFT_MAIN_PROJ_SPLIT=1 SGLANG_RUST_BUILD_MODE=never"
